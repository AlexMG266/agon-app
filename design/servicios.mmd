classDiagram
    direction TB

    %% --- Controladores (Capa REST - Endpoints) --- %%
    class UserController {
        -UserService userService
        -JwtGenerator jwtGenerator
        +POST /users/signup(UserDto dto) ResponseEntity~AuthenticatedUserDto~
        +POST /users/login(LoginParamsDto dto) AuthenticatedUserDto
        +POST /users/google(GoogleLoginParamsDto dto) AuthenticatedUserDto
        +POST /users/loginFromServiceToken() AuthenticatedUserDto
        +PUT /users/{id}(UserDto dto) UserDto
        +POST /users/{id}/changePassword(ChangePasswordParamsDto dto) void
        +GET /users/{id}/elo-history() List~EloHistorialDto~
    }

    class EquipoController {
        -EquipoService equipoService
        +POST /teams(CrearEquipoParamsDto params) EquipoDto
        +POST /teams/{id}/solicitudes(CrearSolicitudParamsDto params) SolicitudDto
        +POST /teams/solicitudes(CrearSolicitudParamsDto params) SolicitudDto
        +PATCH /teams/solicitudes/{solicitudId}(ResponderSolicitudParamsDto params) void
        +DELETE /teams/{id}/miembros/me() void
        +DELETE /teams/{id}/miembros/{memberId}() void
        +DELETE /teams/{id}() void
        +GET /teams() List~EquipoDto~
        +GET /teams/{id}() EquipoDto
        +GET /teams/by-code/{codigo}() EquipoDto
    }

    class NotificationController {
        -NotificationService notificationService
        +GET /notifications(page, size) BlockDto~NotificationDto~
        +GET /notifications/unread-count() long
        +GET /notifications/{notificationId}() NotificationDto
        +PUT /notifications/{notificationId}() NotificationDto
    }

    class TorneoController {
        -TorneoService torneoService
        +POST /tournaments(CrearTorneoParamsDto params) TorneoDto
        +PUT /tournaments/{id}(ActualizarTorneoParamsDto params) TorneoDto
        +PATCH /tournaments/{id}/estructura(ConfigurarEstructuraParamsDto params) TorneoDto
        +POST /tournaments/{id}/inscripciones(InscribirEquipoParamsDto params) SolicitudDto
        +PATCH /tournaments/{id}(ActualizarEstadoTorneoParamsDto params) TorneoDto
        +GET /tournaments/my() List~TorneoDto~
        +PUT /tournaments/{id}/seguidores/me() void
        +DELETE /tournaments/{id}/seguidores/me() void
        +GET /tournaments/followed() List~TorneoDto~
        +GET /tournaments/enrolled() List~TorneoDto~
        +GET /tournaments(filtro, estado, page, size) BlockDto~TorneoDto~
        +GET /tournaments/{id}() TorneoDto
        +GET /tournaments/by-code/{codigo}() TorneoDto
        +GET /tournaments/{id}/inscripciones() List~SolicitudDto~
        +PATCH /tournaments/{id}/inscripciones/{solicitudId}(ActualizarInscripcionParamsDto params) TorneoDto
        +GET /tournaments/{id}/jornadas() List~JornadaDto~
        +GET /tournaments/inscripciones/{solicitudId}() SolicitudDto
    }

    class EncuentroController {
        -IEncuentroService encuentroService
        +GET /encuentros() List~FechaEncuentrosDto~
        +PUT /encuentros/{encuentroId}/resultado(RegistrarResultadoParamsDto params) void
        +POST /encuentros/{encuentroId}/aplazamientos(SolicitarAplazamientoParamsDto params) void
        +PATCH /encuentros/aplazamientos/{solicitudId}(ResponderSolicitudParamsDto params) void
    }

    %% --- DTOs con atributos completos --- %%
    class UserDto {
        <<DTO>>
        +Long id
        +int elo
        +String nombre
        +String email
        +String imagenPerfil
        +String password
        +LocalDate fechaNacimiento
        +boolean eloProvisional
        +boolean notificacionesPartidos
        +int diasAntelacionPartidos
    }

    class LoginParamsDto {
        <<DTO>>
        +String nombre
        +String password
    }

    class GoogleLoginParamsDto {
        <<DTO>>
        +String googleToken
    }

    class AuthenticatedUserDto {
        <<DTO>>
        +String serviceToken
        +UserDto userDto
    }

    class ChangePasswordParamsDto {
        <<DTO>>
        +String oldPassword
        +String newPassword
    }

    class EloHistorialDto {
        <<DTO>>
        +Long id
        +Long encuentroId
        +String equipoLocal
        +String equipoVisitante
        +String resultado
        +int eloAnterior
        +int eloNuevo
        +int variacion
        +LocalDateTime fecha
    }

    class NotificationDto {
        <<DTO>>
        +Long id
        +String asunto
        +String cuerpo
        +boolean leido
        +boolean pendienteDeAccion
        +Long referenciaId
        +String tipo
        +Long fechaCreacion
    }

    class EquipoDto {
        <<DTO>>
        +Long id
        +String nombreEquipo
        +String estado
        +String descripcion
        +Long creadorId
        +String codigoEquipo
        +List~UserDto~ miembros
        +Long fechaCreacion
    }

    class CrearEquipoParamsDto {
        <<DTO>>
        +String nombreEquipo
        +String descripcion
    }

    class CrearSolicitudParamsDto {
        <<DTO>>
        +Long jugadorId
        +String codigoEquipo
    }

    class SolicitudDto {
        <<DTO>>
        +Long id
        +Long candidatoId
        +String nombreCandidato
        +Long decisorId
        +Long equipoId
        +String nombreEquipo
        +Long torneoId
        +String estado
        +String tipoSolicitud
        +long fechaCreacion
    }

    class ResponderSolicitudParamsDto {
        <<DTO>>
        +boolean aceptar
    }

    class TorneoDto {
        <<DTO>>
        +Long id
        +String nombre
        +int numGrupos
        +int equiposPorGrupo
        +boolean tienePlayoff
        +EstadoTorneo estado
        +Long organizadorId
        +String organizadorNombre
        +String tipoTorneo
        +boolean idaVueltaPlayoff
        +int numEquiposInscritos
        +boolean privado
        +String codigoTorneo
        +List~InscripcionDto~ inscripciones
        +String fechaInicio
        +String fechaFin
        +String fechaLimiteInscripcion
        +int puntosVictoria
        +int puntosEmpate
        +int puntosDerrota
        +String formatoPartidos
        +String criterioDesempate
        +List~String~ diasDisponibles
        +String horaInicio
        +String horaFin
        +int duracionPartido
        +List~String~ fechasExcluidas
        +String estrategiaDistribucion
        +int diasEntreJornadas
        +String estrategiaPlayoff
        +int diasEntrePlayoff
        +String rondaInicioPlayoff
    }

    class CrearTorneoParamsDto {
        <<DTO>>
        +String nombre
        +String fechaInicio
        +String fechaLimiteInscripcion
        +int puntosVictoria
        +int puntosEmpate
        +int puntosDerrota
        +String formatoPartidos
        +String criterioDesempate
        +List~String~ diasDisponibles
        +String horaInicio
        +String horaFin
        +int duracionPartido
        +List~String~ fechasExcluidas
        +String estrategiaDistribucion
        +Integer diasEntreJornadas
        +Boolean privado
    }

    class ActualizarTorneoParamsDto {
        <<DTO>>
        +String nombre
        +String fechaInicio
        +String fechaFin
        +String fechaLimiteInscripcion
        +Integer puntosVictoria
        +Integer puntosEmpate
        +Integer puntosDerrota
        +String formatoPartidos
        +String criterioDesempate
        +List~String~ diasDisponibles
        +String horaInicio
        +String horaFin
        +Integer duracionPartido
        +List~String~ fechasExcluidas
        +String estrategiaDistribucion
        +Integer diasEntreJornadas
    }

    class ConfigurarEstructuraParamsDto {
        <<DTO>>
        +String tipoTorneo
        +int numGrupos
        +int equiposPorGrupo
        +boolean tienePlayoff
        +boolean idaVueltaPlayoff
        +String estrategiaPlayoff
        +Integer diasEntrePlayoff
        +String rondaInicioPlayoff
        +String fechaFin
    }

    class ActualizarEstadoTorneoParamsDto {
        <<DTO>>
        +String estado
    }

    class ActualizarInscripcionParamsDto {
        <<DTO>>
        +String estado
    }

    class InscribirEquipoParamsDto {
        <<DTO>>
        +Long equipoId
        +String codigoTorneo
    }

    class InscripcionDto {
        <<DTO>>
        +Long equipoId
        +String nombreEquipo
        +Long creadorId
        +List~UserDto~ miembros
        +Long grupoId
        +String grupoNombre
        +int partidosJugados
        +int partidosGanados
        +int partidosEmpatados
        +int partidosPerdidos
        +int setsGanados
        +int setsPerdidos
        +int diferenciaSets
        +int puntosLiga
    }

    class JornadaDto {
        <<DTO>>
        +Long id
        +int numeroJornada
        +String tipoFase
        +LocalDate fechaInicio
        +LocalDate fechaFin
        +List~EncuentroDto~ encuentros
    }

    class EncuentroDto {
        <<DTO>>
        +Long id
        +Long equipoLocalId
        +String equipoLocalNombre
        +Long equipoVisitanteId
        +String equipoVisitanteNombre
        +String estado
        +LocalDateTime fechaRealizacion
        +List~SetDto~ sets
        +Long ganadorId
        +String resultado
    }

    class SetDto {
        <<DTO>>
        +int numeroSet
        +int golesLocal
        +int golesVisitante
    }

    class FechaEncuentrosDto {
        <<DTO>>
        +LocalDate fecha
        +List~EncuentroDto~ encuentros
    }

    class RegistrarResultadoParamsDto {
        <<DTO>>
        +List~SetDto~ sets
    }

    class SolicitarAplazamientoParamsDto {
        <<DTO>>
        +LocalDateTime fecha
        +String motivo
    }

    class BlockDto {
        <<DTO>>
        +List items
        +boolean existMoreItems
    }

    %% --- Dependencias Controladores -> Interfaces de Servicio --- %%
    UserController --> UserService : @Autowired
    EquipoController --> EquipoService : @Autowired
    NotificationController --> NotificationService : @Autowired
    TorneoController --> TorneoService : @Autowired
    EncuentroController --> IEncuentroService : @Autowired

    %% --- Dependencias Controladores -> DTOs --- %%
    UserController ..> UserDto : usa
    UserController ..> LoginParamsDto : recibe
    UserController ..> GoogleLoginParamsDto : recibe
    UserController ..> AuthenticatedUserDto : devuelve
    UserController ..> ChangePasswordParamsDto : recibe
    UserController ..> EloHistorialDto : devuelve

    EquipoController ..> EquipoDto : usa/devuelve
    EquipoController ..> CrearEquipoParamsDto : recibe
    EquipoController ..> CrearSolicitudParamsDto : recibe
    EquipoController ..> SolicitudDto : devuelve
    EquipoController ..> ResponderSolicitudParamsDto : recibe

    NotificationController ..> NotificationDto : usa/devuelve
    NotificationController ..> BlockDto : devuelve

    TorneoController ..> TorneoDto : usa/devuelve
    TorneoController ..> CrearTorneoParamsDto : recibe
    TorneoController ..> ActualizarTorneoParamsDto : recibe
    TorneoController ..> ConfigurarEstructuraParamsDto : recibe
    TorneoController ..> ActualizarEstadoTorneoParamsDto : recibe
    TorneoController ..> ActualizarInscripcionParamsDto : recibe
    TorneoController ..> InscribirEquipoParamsDto : recibe
    TorneoController ..> SolicitudDto : devuelve
    TorneoController ..> InscripcionDto : usa
    TorneoController ..> JornadaDto : devuelve
    TorneoController ..> BlockDto : devuelve

    EncuentroController ..> FechaEncuentrosDto : devuelve
    EncuentroController ..> EncuentroDto : usa
    EncuentroController ..> RegistrarResultadoParamsDto : recibe
    EncuentroController ..> SolicitarAplazamientoParamsDto : recibe
    EncuentroController ..> ResponderSolicitudParamsDto : recibe
    EncuentroController ..> SetDto : usa
