classDiagram
    direction TB

    %% --- Controladores (Capa REST - Endpoints) --- %%
    class UserController {
        -UserService userService
        -JwtGenerator jwtGenerator
        +POST /signup(UsuarioDto dto) ResponseEntity
        +POST /login(LoginParamsDto dto) AuthenticatedUserDto
        +POST /loginFromServiceToken(Long userId) AuthenticatedUserDto
        +PUT /{id}(Long userId, Long id, UserDto dto) UserDto
        +POST /{id}/changePassword(Long userId, Long id, ChangePasswordParamsDto dto) void
    }

    class EquipoController {
        -EquipoService equipoService
        +POST /teams(Long userId, CrearEquipoParamsDto params) EquipoDto
        +POST /teams/{id}/propuestas(Long userId, Long id, Long jugadorId) SolicitudDto
        +POST /teams/peticiones(Long userId, String codigoEquipo) SolicitudDto
        +POST /teams/solicitudes/{solicitudId}/responder(Long userId, Long solicitudId, ResponderSolicitudParamsDto params) void
        +POST /teams/{id}/leave(Long userId, Long id) void
        +POST /teams/{id}/members/{memberId}/kick(Long userId, Long id, Long memberId) void
        +DELETE /teams/{id}(Long userId, Long id) void
        +GET /teams(Long userId) List~EquipoDto~
        +GET /teams/{id}(Long userId, Long id) EquipoDto
        +GET /teams/by-code/{codigo}(Long userId, String codigo) EquipoDto
    }

    class NotificationController {
        -NotificationService notificationService
        +GET /notifications(Long userId) List~NotificationDto~
        +GET /notifications/{notificationId}(Long userId, Long notificationId) NotificationDto
        +PUT /notifications/{notificationId}(Long userId, Long notificationId) NotificationDto
    }

    class TorneoController {
        -ITorneoService torneoService
        +buscarTorneos(String filtro) ResponseEntity
        +consultarTorneo(Long torneoId) ResponseEntity
        +crearTorneo(Long orgId, TorneoDto dto) ResponseEntity
        +inscribirYValidarEquipo(Long capitanId, Long torneoId, Long equipoId) ResponseEntity
        +cerrarInscripciones(Long torneoId) ResponseEntity
        +generarCalendario(Long torneoId) ResponseEntity
        +generarCodigoQR(Long torneoId) ResponseEntity
        +gestionarJornadas(Long torneoId, Long jornadaId, EstadoJornada nuevoEstado) ResponseEntity
    }

    class EncuentroController {
        -IEncuentroService encuentroService
        +consultarEncuentrosPropios(Long userId) ResponseEntity
        +registrarResultado(Long encuentroId, List~SetDto~ sets) ResponseEntity
        +solicitarAplazamiento(Long capitanId, Long encuentroId, AplazamientoDto dto) ResponseEntity
    }

    %% --- DTOs con atributos completos --- %%
    class UserDto {
        <<DTO>>
        +Long id
        +int elo
        +String nombre
        +String email
        +String imagenPerfil
        +String password
        +LocalDate fechaNacimiento
        +boolean eloProvisional
    }

    class LoginParamsDto {
        <<DTO>>
        +String nombre
        +String password
    }

    class AuthenticatedUserDto {
        <<DTO>>
        +String serviceToken
        +UserDto userDto
    }

    class ChangePasswordParamsDto {
        <<DTO>>
        +String oldPassword
        +String newPassword
    }

    class NotificationDto {
        <<DTO>>
        +Long id
        +String asunto
        +String cuerpo
        +boolean leido
        +boolean pendienteDeAccion
        +Long referenciaId
        +String tipo
        +Long fechaCreacion
    }

    class EquipoDto {
        <<DTO>>
        +Long id
        +String nombreEquipo
        +String estado
        +String descripcion
        +Long creadorId
        +String codigoEquipo
        +List~UserDto~ miembros
    }

    class CrearEquipoParamsDto {
        <<DTO>>
        +String nombreEquipo
        +String descripcion
    }

    class SolicitudDto {
        <<DTO>>
        +Long id
        +Long candidatoId
        +Long decisorId
        +Long equipoId
        +String estado
        +String tipoSolicitud
        +long fechaCreacion
    }

    class ResponderSolicitudParamsDto {
        <<DTO>>
        +boolean aceptar
    }

    class TorneoDto {
        <<DTO>>
        +Long id
        +String nombre
        +int numGrupos
        +int equiposPorGrupo
        +boolean tienePlayoff
        +EstadoTorneo estado
    }

    class EncuentroDto {
        <<DTO>>
        +Long id
        +Long equipoLocalId
        +Long equipoVisitanteId
        +EstadoEncuentro estadoEncuentro
        +LocalDateTime fechaRealizacion
    }

    class SetDto {
        <<DTO>>
        +int numeroSet
        +int golesLocal
        +int golesVisitante
    }

    class AplazamientoDto {
        <<DTO>>
        +LocalDateTime fechaSolicitada
        +String motivo
    }

    %% --- Dependencias Controladores -> Interfaces de Servicio --- %%
    UserController --> UserService : @Autowired
    EquipoController --> EquipoService : @Autowired
    NotificationController --> NotificationService : @Autowired
    TorneoController --> ITorneoService : @Autowired
    EncuentroController --> IEncuentroService : @Autowired

    %% --- Dependencias Controladores -> DTOs --- %%
    UserController ..> UserDto : usa
    UserController ..> LoginParamsDto : usa
    UserController ..> AuthenticatedUserDto : devuelve
    UserController ..> ChangePasswordParamsDto : recibe
    UserController ..> NotificationDto : (via NotificationService)

    EquipoController ..> EquipoDto : usa/devuelve
    EquipoController ..> CrearEquipoParamsDto : recibe
    EquipoController ..> SolicitudDto : devuelve
    EquipoController ..> ResponderSolicitudParamsDto : recibe

    NotificationController ..> NotificationDto : usa/devuelve

    TorneoController ..> TorneoDto : usa

    EncuentroController ..> EncuentroDto : devuelve
    EncuentroController ..> SetDto : recibe
    EncuentroController ..> AplazamientoDto : recibe
