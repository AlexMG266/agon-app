    EquipoServiceImpl ..> NotificationDispatcher : @Autowired

    NotificationServiceImpl ..> NotificationDao : @Autowired

    TorneoServiceImpl ..> TorneoDao : @Autowired
    TorneoServiceImpl ..> InscripcionDao : @Autowired
    TorneoServiceImpl ..> JornadaDao : @Autowired
    TorneoServiceImpl ..> GrupoDao : @Autowired
    TorneoServiceImpl ..> EquipoDao : @Autowired
    TorneoServiceImpl ..> SeguimientoTorneoDao : @Autowired
    TorneoServiceImpl ..> SolicitudDao : @Autowired
    TorneoServiceImpl ..> NotificationDao : @Autowired
    TorneoServiceImpl ..> Clock : @Autowired

    EncuentroServiceImpl ..> EncuentroDao : @Autowired
    EncuentroServiceImpl ..> InscripcionDao : @Autowired
    EncuentroServiceImpl ..> SolicitudAplazamientoDao : @Autowired
    EncuentroServiceImpl ..> EquipoDao : @Autowired
    EncuentroServiceImpl ..> NotificationDao : @Autowired
    EncuentroServiceImpl ..> EloHistorialDao : @Autowired
    EncuentroServiceImpl ..> UserDao : @Autowired
    EncuentroServiceImpl ..> NotificationDispatcher : @Autowired
    EncuentroServiceImpl ..> TorneoService : @Autowired
    EncuentroServiceImpl ..> Clock : @Autowired

    NotificationDispatcher ..> NotificationDao : @Autowired
