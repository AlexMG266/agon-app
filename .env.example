# ============================================================
# Variables de entorno para PRODUCCIÓN (Agón App)
#
# Uso:
#   cp .env.example .env
#   # edita .env con los valores reales y ejecuta:
#   docker compose -f docker-compose.prod.yml up -d --build
#
# NUNCA subas .env al repositorio (ya está ignorado en .gitignore).
# ============================================================

# --- PostgreSQL ---
# Usuario, contraseña y nombre de la base de datos de producción.
# ¡Cambia la contraseña por una fuerte!
POSTGRES_USER=agon
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=agon

# --- JWT (clave crítica de seguridad) ---
# Secreto de firma de los tokens JWT. Genera uno fuerte con:
#   openssl rand -hex 64
# IMPORTANTE: debe tener AL MENOS 32 caracteres (256 bits). Con menos, jjwt
# lanza WeakKeyException y el login falla con 403 (aunque la autenticación
# sea correcta). NO lo dejes como el placeholder de ejemplo.
# Si esta clave se filtra, cualquiera podría falsificar tokens de sesión.
JWT_SIGN_KEY=cambia-este-secreto-jwt

# Minutos de validez de los tokens JWT (default: 1440 = 24 horas)
JWT_EXPIRATION_MINUTES=1440

# --- Frontend: URL base de la API (build arg) ---
# El valor se inyecta en el build del frontend (VITE_BACKEND_URL) y NO se
# puede cambiar sin reconstruir la imagen.
#
# Con Nginx Proxy Manager se usa un subdominio dedicado para la API. La API
# se sirve en la RAÍZ de ese dominio (sin prefijo /api).
#   VITE_BACKEND_URL=https://api.tudominio.com
VITE_BACKEND_URL=https://api.tudominio.com

# --- Google OAuth (Sign in with Google) ---
# Client ID de OAuth 2.0 de Google (se crea en Google Cloud Console:
# APIs y servicios > Credenciales > Crear credenciales > ID de cliente de
# OAuth). El valor se inyecta en el build del frontend (VITE_GOOGLE_CLIENT_ID)
# y en el backend (GOOGLE_CLIENT_ID), por lo que cambiar el Client ID
# requiere reconstruir las imágenes.
#   https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com

# --- CORS ---
# Orígenes permitidos por CORS, separados por coma (sin espacios).
# Debe incluir el origen REAL con el que navegan los usuarios, p. ej.:
#   CORS_ALLOWED_ORIGINS=https://app.tudominio.com
#
# Como frontend y API usan dominios distintos (cross-origin), CORS SÍ se
# aplica y este valor es obligatorio.
CORS_ALLOWED_ORIGINS=https://app.tudominio.com
