
# Use Node.js 22 Alpine for frontend development
FROM node:22-alpine

WORKDIR /app

# Copy package management files
COPY package.json package-lock.json* /app/

# Install exact locked dependencies (faster and reproducible than `npm install`)
RUN npm ci --no-audit --no-fund

# Copy source code
COPY . /app

EXPOSE 5173

# Run the Vite dev server binding to 0.0.0.0 so host can access it
CMD ["npm", "run", "dev", "--", "--host"]
