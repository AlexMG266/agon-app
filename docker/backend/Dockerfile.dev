
# Use Maven with Eclipse Temurin (JDK 21) on Alpine as base image for development
# (the Alpine variant downloads ~300 MB less than the full Ubuntu-based image)
FROM maven:3.9.9-eclipse-temurin-21-alpine

WORKDIR /app

# Copy pom.xml to cache dependencies
COPY backend/pom.xml /app/

# Pre-download ONLY the dependencies declared in pom.xml and the build plugins.
# Much lighter than `mvn dependency:go-offline`, which downloads the whole
# Maven plugin universe (hundreds of MB more than the project needs).
RUN mvn -B -DskipTests dependency:resolve dependency:resolve-plugins

# Copy the source code
COPY backend/src /app/src

COPY docker/backend/entrypoint.dev.sh /entrypoint.dev.sh
RUN chmod +x /entrypoint.dev.sh

EXPOSE 8080

ENTRYPOINT ["/entrypoint.dev.sh"]
